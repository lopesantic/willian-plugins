<?xml version="1.0" encoding="UTF-8"?>
<!-- Sharp Frame: um painel só (hub) com todas as ferramentas em abas. Sem login, sem servidor.
     O ID interno continua com.willian.plugins para o instalador atualizar por cima da instalação antiga. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.willian.plugins" ExtensionBundleVersion="1.9.1" ExtensionBundleName="Sharp Frame" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.willian.plugins.hub" Version="0.2.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="PPRO" Version="[25.0,99.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.willian.plugins.hub">
      <DispatchInfo>
        <Resources>
          <MainPath>./hub/index.html</MainPath>
          <CEFCommandLine><Parameter>--enable-nodejs</Parameter><Parameter>--mixed-context</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Sharp Frame</Menu>
          <Geometry><Size><Height>820</Height><Width>560</Width></Size><MinSize><Height>360</Height><Width>300</Width></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
