<?xml version="1.0" encoding="UTF-8"?>
<!-- Willian Plugins: um pacote, um painel por ferramenta. Sem login, sem servidor. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.willian.plugins" ExtensionBundleVersion="0.3.0" ExtensionBundleName="Willian Plugins" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.willian.plugins.margens" Version="0.1.0"/>
    <Extension Id="com.willian.plugins.autocut" Version="0.1.0"/>
    <Extension Id="com.willian.plugins.beatmarker" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="PPRO" Version="[25.0,99.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.willian.plugins.margens">
      <DispatchInfo>
        <Resources>
          <MainPath>./margens/index.html</MainPath>
          <CEFCommandLine><Parameter>--enable-nodejs</Parameter><Parameter>--mixed-context</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Willian - Margens</Menu>
          <Geometry><Size><Height>320</Height><Width>300</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.willian.plugins.autocut">
      <DispatchInfo>
        <Resources>
          <MainPath>./autocut/index.html</MainPath>
          <CEFCommandLine><Parameter>--enable-nodejs</Parameter><Parameter>--mixed-context</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Willian - AutoCut</Menu>
          <Geometry><Size><Height>620</Height><Width>320</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.willian.plugins.beatmarker">
      <DispatchInfo>
        <Resources>
          <MainPath>./beatmarker/index.html</MainPath>
          <CEFCommandLine><Parameter>--enable-nodejs</Parameter><Parameter>--mixed-context</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Willian - BeatMarker</Menu>
          <Geometry><Size><Height>600</Height><Width>320</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
